getgenv().Animator6D = function(idOrInstance, speed, looped, fadeTime)
    local kfs
    if typeof(idOrInstance) == "Instance" then
        kfs = idOrInstance:IsA("KeyframeSequence") and idOrInstance or idOrInstance:FindFirstChildWhichIsA("KeyframeSequence",true)
    else
        local asset = LoadLocalAsset(idOrInstance)
        if asset then
            kfs = asset:IsA("KeyframeSequence") and asset or asset:FindFirstChildWhichIsA("KeyframeSequence",true)
        end
    end

    if not kfs then
        warn("[Animator6D] Could not load animation:",idOrInstance)
        return
    end

    local previous = getgenv().currentAnimator6D
    local baseTransform
    local startOffsets

    if previous then
        baseTransform = previous.savedTransform
        startOffsets = previous:GetCurrentOffsets()
        previous:Stop(false)
    else
        baseTransform = nil
        startOffsets = nil
    end

    disableDefaultAnimations(char)

    local anim = AnimPlayer.new(char,kfs,baseTransform,startOffsets)
    getgenv().currentAnimator6D = anim
    anim:Play(speed or 1,looped,fadeTime)
    return anim.length
end

getgenv().Animator6DStop = function(fadeTime)
    local current = getgenv().currentAnimator6D
    if not current then
        restoreDefaultAnimations()
        return
    end

    fadeTime = tonumber(fadeTime) or 0

    if fadeTime > 0 then
        current:FadeOut(fadeTime)
    else
        current:Stop(true)
        getgenv().currentAnimator6D = nil
        restoreDefaultAnimations()
    end
end

