function AnimPlayer:GetTrackPose(track, time)
    local count = #track
    if count == 0 then
        return CFrame.new()
    end

    if count == 1 then
        return track[1].CFrame
    end

    local low = 1
    local high = count
    while low <= high do
        local mid = math.floor((low + high) / 2)
        if track[mid].Time <= time then
            low = mid + 1
        else
            high = mid - 1
        end
    end

    local previous = track[math.max(1, high)]
    local nextSample = track[math.min(count, high + 1)]
    if previous == nextSample then
        return previous.CFrame
    end

    local duration = nextSample.Time - previous.Time
    if duration <= 0 then
        return nextSample.CFrame
    end

    local alpha = math.clamp((time - previous.Time) / duration,0,1)
    return previous.CFrame:Lerp(nextSample.CFrame,alpha)
end

function AnimPlayer:ApplyPose(alpha)
    alpha = math.clamp(alpha or 1, 0, 1)

    for joint, track in pairs(self.tracks) do
        if self:IsMotorEnabled(joint) then
            local target = self:GetTrackPose(track, self.time)
            local initial = self.startOffsets[joint] or CFrame.new()
            local finalPose = initial:Lerp(target, alpha)

            pcall(function()
                joint.Transform = finalPose
            end)
        end
    end
end

function AnimPlayer:StartFade(duration)
    duration = math.max(0, tonumber(duration) or 0)
    self.fadeDuration = duration
    self.fadeElapsed = 0

    if duration <= 0 then
        self.startOffsets = {}
        return
    end
end

function AnimPlayer:FadeOut(duration)
    if not self.playing then
        return
    end

    duration = math.max(0, tonumber(duration) or 0)

    if duration <= 0 then
        self:Stop(true)
        return
    end

    self.startOffsets = self:GetCurrentOffsets()
    self.fadeDuration = duration
    self.fadeElapsed = 0
    self.fadingOut = true
end

function AnimPlayer:Step(dt)
    if not self.playing or self.suspended then
        return
    end

    if self.fadingOut then
        self.fadeElapsed += dt
        local alpha = math.clamp(self.fadeElapsed / self.fadeDuration, 0, 1)
        self:ApplyPose(1 - alpha)

        if alpha >= 1 then
            self:Stop(true)
            if getgenv().currentAnimator6D == self then
                getgenv().currentAnimator6D = nil
                if restoreDefaultAnimations then
                    restoreDefaultAnimations()
                end
            end
            return
        end
    end

    self.time += dt * self.speed

    if self.time >= self.length then
        if self.looped then
            self.time = self.time % self.length
            self.frameIndex = 1
        else
            self.time = self.length
            self:ApplyPose(1)
            self:FadeOut(0.12)
            return
        end
    end

    local alpha = 1
    if self.fadeDuration > 0 and not self.fadingOut then
        self.fadeElapsed += dt
        alpha = math.clamp(self.fadeElapsed / self.fadeDuration, 0, 1)
    end

    self:ApplyPose(alpha)

    if alpha >= 1 then
        self.startOffsets = {}
        self.fadeDuration = 0
    end
end

function AnimPlayer:ConnectHeartbeat()
    if self.conn or not self.playing or self.suspended then
        return
    end

    self.conn = RunService.PreSimulation:Connect(function(dt)
        self:Step(dt)
    end)
end

function AnimPlayer:Play(speed, loop, fadeTime)
    if self.playing or #self.seq == 0 then
        return
    end

    self.playing = true
    self.suspended = false
    self.speed = tonumber(speed) or 1
    self.looped = loop == nil and self.sequenceLoop or loop

    if self.looped == nil then
        self.looped = true
    end

    self.time = 0
    self.frameIndex = 1
    self.fadingOut = false
    self:StartFade(fadeTime == nil and 0.25 or fadeTime)

    local anyEnabled = false
    for _, enabled in pairs(self.limbToggles) do
        if enabled then
            anyEnabled = true
            break
        end
    end

    if not anyEnabled then
        self.suspended = true
        return
    end

    self:ConnectHeartbeat()
end

function AnimPlayer:Stop(restore)
    self.playing = false
    self.suspended = false

    if self.conn then
        self.conn:Disconnect()
        self.conn = nil
    end
end

